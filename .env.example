# ==========================================
# My Library — Environment Configuration
# ==========================================

# Set to 'false' to connect to live Appwrite, or 'true' to use local offline browser storage
VITE_USE_MOCK_FALLBACK=true

# Appwrite Cloud / Self-hosted Instance Details
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=my_library_db

# Collection IDs (auto-generated by backend/setup-appwrite-db.js)
VITE_APPWRITE_COLLECTION_PROFILES=user_profiles
VITE_APPWRITE_COLLECTION_BOOKS=books
VITE_APPWRITE_COLLECTION_READING_STATES=reading_states
VITE_APPWRITE_COLLECTION_CERTIFICATES=certificates
VITE_APPWRITE_COLLECTION_PROJECTS=projects

# Cloudflare R2 Storage (Optional for live uploads)
VITE_R2_SIGNER_ENDPOINT=http://localhost:8787
VITE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
